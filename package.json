{
  "name": "prime-dispatch-prototype",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "bin": {
    "prime-dispatch": "dist/cli.js",
    "prime-dispatch-openclaw": "dist/openclaw-host.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:apply": "node dist/cli.js migration-apply",
    "migration:create": "node scripts/create-migration.mjs",
    "migration:status": "node dist/cli.js migration-status",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "test:openclaw-lifecycle": "PRIME_DISPATCH_OPENCLAW_LIFECYCLE_ACCEPTANCE=1 node --test test/openclaw-lifecycle.integration.test.js",
    "pretest:live": "tsc -p tsconfig.json",
    "test:live": "PRIME_DISPATCH_LIVE_ACCEPTANCE=1 node --test --test-concurrency=1 test/live-prime.acceptance.test.js test/live-prime-cancellation.acceptance.test.js test/live-prime-multichild.acceptance.test.js",
    "pretest:live:multi-child": "tsc -p tsconfig.json",
    "test:live:multi-child": "PRIME_DISPATCH_LIVE_MULTI_CHILD_ACCEPTANCE=1 node --test --test-concurrency=1 test/live-prime-multichild.acceptance.test.js",
    "test:adapter": "corepack pnpm --dir openclaw-plugin run build && corepack pnpm --dir openclaw-plugin test"
  },
  "dependencies": {
    "canonicalize": "4.0.0",
    "commander": "15.0.0",
    "eventsource-parser": "4.0.0",
    "kysely": "0.29.5",
    "tar": "7.5.22",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
